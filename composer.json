{
    "name": "psc-acme/tracker-payment",
    "description": "Package tracker-payment for psc-acme organization",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Philipp Scheit",
            "email": "p.scheit@packagist.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "PscAcme\\TrackerPayment\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "symfony/lock": "^7.0",
        "symfony/routing": "^7.0",
        "symfony/http-foundation": "^7.0",
        "nette/utils": "^4.0",
        "illuminate/support": "^11.0",
        "monolog/monolog": "^3.2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "symfony/phpunit-bridge": "^7.0",
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "config": {
        "secure-http": false
    },
    "repositories": {
        "private-packagist": {
            "type": "composer",
            "url": "http://repo.packagist.com.lo/psc-acme/"
        },
        "packagist.org": false
    }
}